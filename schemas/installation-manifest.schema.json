{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-think.local/schemas/installation-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_version",
    "bundle_root",
    "runtime_root",
    "mode",
    "targets",
    "platform_skill_roots",
    "installed",
    "backups",
    "migrations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "bundle_root": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["copy", "symlink"]
    },
    "targets": {
      "type": "array",
      "items": {
        "enum": ["opencode", "codex", "claude", "cursor"]
      },
      "uniqueItems": true
    },
    "platform_skill_roots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opencode": {"type": "string", "minLength": 1},
        "codex": {"type": "string", "minLength": 1},
        "claude": {"type": "string", "minLength": 1},
        "cursor": {"type": "string", "minLength": 1}
      }
    },
    "installed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "status"],
        "additionalProperties": true
      }
    },
    "backups": {
      "type": "array",
      "maxItems": 0
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "runtime_root": {
      "type": "string",
      "minLength": 1
    }
  }
}
