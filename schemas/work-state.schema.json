{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-think.local/schemas/work-state.schema.json",
  "title": "t-think work state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "current_state",
    "current_run_id",
    "model_profile",
    "repository_root",
    "work_directory",
    "active_skill",
    "active_agent",
    "human_gate_pending",
    "history"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2.3.0",
        "2.4.0"
      ]
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "current_state": {
      "enum": [
        "PROBLEM_ALIGNMENT",
        "INVESTIGATION",
        "SYSTEM_MODEL",
        "MODEL_CRITIQUE",
        "SOLUTION_DESIGN",
        "SOLUTION_CRITIQUE",
        "IMPLEMENTATION_BLUEPRINT",
        "BLUEPRINT_CRITIQUE",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_REVIEW",
        "VERIFICATION",
        "RECONCILIATION",
        "COMPLETED"
      ]
    },
    "current_run_id": {
      "type": "string",
      "minLength": 1
    },
    "model_profile": {
      "enum": [
        "economy",
        "balanced",
        "high-assurance"
      ]
    },
    "repository_root": {
      "type": "string",
      "minLength": 1
    },
    "work_directory": {
      "type": "string",
      "minLength": 1
    },
    "active_skill": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_gate": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_validator": {
      "type": [
        "object",
        "null"
      ]
    },
    "human_gate_pending": {
      "type": "boolean"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "governance_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "selected",
        "artifact_mode",
        "risk_score",
        "hard_triggers",
        "assessment_path",
        "waiver_path"
      ],
      "properties": {
        "requested": {
          "enum": [
            "auto",
            "quick",
            "standard",
            "full"
          ]
        },
        "selected": {
          "enum": [
            "quick",
            "standard",
            "full"
          ]
        },
        "artifact_mode": {
          "enum": [
            "compact",
            "normal",
            "exhaustive"
          ]
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0
        },
        "hard_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "assessment_path": {
          "type": "string",
          "minLength": 1
        },
        "waiver_path": {
          "type": "string",
          "minLength": 1
        },
        "promotion_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "work_status": {
      "enum": [
        "active",
        "waiting_human",
        "blocked",
        "interrupted",
        "completed",
        "abandoned",
        "archived"
      ]
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint_path": {
      "type": "string",
      "pattern": "^\\.t-think/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/session/resume\\.yaml$"
    },
    "activity_path": {
      "type": "string",
      "pattern": "^\\.t-think/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/session/activity\\.jsonl$"
    },
    "lease_path": {
      "type": "string",
      "pattern": "^\\.t-think/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/session/lease\\.yaml$"
    },
    "session_generation": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.4.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "work_status",
          "last_activity_at",
          "current_session_id",
          "checkpoint_path",
          "activity_path",
          "lease_path",
          "session_generation"
        ]
      }
    }
  ]
}
