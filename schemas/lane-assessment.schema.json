{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-think.local/schemas/lane-assessment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "classifier_version",
    "requested_lane",
    "recommended_lane",
    "selected_lane",
    "selection_source",
    "risk_score",
    "signals",
    "hard_triggers",
    "forced_promotion",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "classifier_version": {
      "type": "string",
      "minLength": 1
    },
    "requested_lane": {
      "enum": [
        "auto",
        "quick",
        "standard",
        "full"
      ]
    },
    "recommended_lane": {
      "enum": [
        "quick",
        "standard",
        "full"
      ]
    },
    "selected_lane": {
      "enum": [
        "quick",
        "standard",
        "full"
      ]
    },
    "selection_source": {
      "enum": [
        "automatic",
        "explicit_human_request",
        "forced_hard_trigger",
        "promotion",
        "forced_policy_floor"
      ]
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0
    },
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "weight",
          "hard_trigger",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer"
          },
          "hard_trigger": {
            "type": "boolean"
          },
          "source": {
            "enum": [
              "declared",
              "keyword_hint",
              "promotion"
            ]
          }
        }
      }
    },
    "hard_triggers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "forced_promotion": {
      "type": "boolean"
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "previous_lane": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "quick",
        "standard",
        "full",
        null
      ]
    },
    "promotion_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
