{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t-think.local/schemas/delegation-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "lifecycle",
    "objective",
    "workspace",
    "permissions",
    "artifact_inputs",
    "output_contract",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "run_id",
        "invocation_id",
        "parent_agent",
        "target_agent"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_agent": {
          "const": "t-think"
        },
        "target_agent": {
          "pattern": "^t-[a-z0-9-]+$"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_phase",
        "skill",
        "attempt"
      ],
      "properties": {
        "current_phase": {
          "type": "string"
        },
        "skill": {
          "pattern": "^t-[a-z0-9-]+$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "lane": {
          "enum": [
            "quick",
            "standard",
            "full"
          ]
        },
        "artifact_mode": {
          "enum": [
            "compact",
            "normal",
            "exhaustive"
          ]
        },
        "expected_next_state": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "completion_criteria"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 5
        },
        "completion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "active_work_directory",
        "discovery"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "respect_vcs_ignore",
            "include_untracked",
            "include_ignored"
          ],
          "properties": {
            "respect_vcs_ignore": {
              "const": false
            },
            "include_untracked": {
              "type": "boolean"
            },
            "include_ignored": {
              "const": true
            }
          }
        },
        "active_work_directory": {
          "type": "string",
          "pattern": "^\\.t-think/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_read",
        "outside_workspace",
        "source_write",
        "governance_artifact_write",
        "approved_write_targets",
        "generated_output_paths",
        "protected_paths",
        "ignored_file_access",
        "spawn_subagent"
      ],
      "properties": {
        "workspace_read": {
          "const": "allow"
        },
        "outside_workspace": {
          "const": "deny"
        },
        "source_write": {
          "enum": [
            "deny",
            "approved_targets_only",
            "generated_outputs_only"
          ]
        },
        "governance_artifact_write": {
          "type": "string",
          "pattern": "^\\.t-think/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/\\*\\*$"
        },
        "approved_write_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated_output_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ignored_file_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "human_approval_ref"
          ],
          "properties": {
            "mode": {
              "enum": [
                "deny",
                "human_approved",
                "allow"
              ]
            },
            "human_approval_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "spawn_subagent": {
          "const": "deny"
        }
      }
    },
    "artifact_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_path",
        "result_path",
        "boundary_report_path"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "result_path": {
          "type": "string",
          "minLength": 1
        },
        "boundary_report_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
