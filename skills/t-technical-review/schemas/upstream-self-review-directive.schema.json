{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/self-review/remediation-directive.schema.json",
  "title": "Self Review Remediation Directive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directive_id",
    "self_review_run_id",
    "finding_ids",
    "target_checklist_ids",
    "route",
    "instruction",
    "constraints",
    "prohibited_actions",
    "evidence_refs",
    "status",
    "applied",
    "semantic_change_required"
  ],
  "properties": {
    "directive_id": {
      "type": "string",
      "pattern": "^SRDIR-"
    },
    "self_review_run_id": {
      "type": "string",
      "pattern": "^SREV-"
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SRF-"
      },
      "uniqueItems": true
    },
    "target_checklist_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CHK-"
      },
      "uniqueItems": true
    },
    "route": {
      "enum": [
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_CHECKLIST",
        "CHECKLIST_CRITIQUE",
        "IMPLEMENTATION_PLAN",
        "PLAN_CRITIQUE",
        "INVESTIGATION",
        "SYSTEM_MODEL",
        "SOLUTION_DESIGN",
        "SOLUTION_CRITIQUE",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "OPEN",
        "CLOSED"
      ]
    },
    "applied": {
      "const": false
    },
    "semantic_change_required": {
      "type": "boolean"
    }
  }
}
