{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/technical-review/change-assessment.schema.json",
  "title": "Technical Change Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "technical_review_run_id",
    "reviewer_id",
    "change_id",
    "checklist_id",
    "path",
    "source_diff_digest",
    "outcome",
    "semantic_conformance",
    "scope_conformance",
    "risk_level",
    "evidence_refs",
    "observations",
    "self_review_conformance_ids",
    "finding_ids",
    "rationale"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "pattern": "^TRCA-"
    },
    "technical_review_run_id": {
      "type": "string",
      "pattern": "^TREV-"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "change_id": {
      "type": "string",
      "pattern": "^CHG-"
    },
    "checklist_id": {
      "type": "string",
      "pattern": "^CHK-"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "source_diff_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES",
        "INCONCLUSIVE"
      ]
    },
    "semantic_conformance": {
      "type": "boolean"
    },
    "scope_conformance": {
      "type": "boolean"
    },
    "risk_level": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "self_review_conformance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRCNF-"
      }
    },
    "finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TRF-"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
