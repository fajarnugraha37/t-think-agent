{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/technical-review/review-finding.schema.json",
  "title": "Technical Review Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "technical_review_run_id",
    "category",
    "severity",
    "blocking",
    "target_ids",
    "summary",
    "expected",
    "observed",
    "evidence_refs",
    "epistemic_status",
    "confidence",
    "status",
    "required_route",
    "remediation_type",
    "rationale"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^TRF-"
    },
    "technical_review_run_id": {
      "type": "string",
      "pattern": "^TREV-"
    },
    "category": {
      "enum": [
        "ARCHITECTURE_DEFECT",
        "IMPLEMENTATION_DEFECT",
        "CHECKLIST_NONCONFORMANCE",
        "SCOPE_DRIFT",
        "SEMANTIC_DRIFT",
        "API_CONTRACT_RISK",
        "DATA_INTEGRITY_RISK",
        "CONCURRENCY_RISK",
        "SECURITY_RISK",
        "RESILIENCE_GAP",
        "PERFORMANCE_RISK",
        "OBSERVABILITY_GAP",
        "OPERABILITY_GAP",
        "MIGRATION_RISK",
        "ROLLBACK_GAP",
        "TEST_GAP",
        "DEPENDENCY_RISK",
        "MAINTAINABILITY_ISSUE",
        "EVIDENCE_GAP",
        "SELF_REVIEW_DEFECT",
        "MODEL_OR_SOLUTION_DEFECT",
        "PROBLEM_MISALIGNMENT"
      ]
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "epistemic_status": {
      "enum": [
        "FACT",
        "INFERENCE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "ACCEPTED_RISK"
      ]
    },
    "required_route": {
      "enum": [
        "NONE",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_CHECKLIST",
        "CHECKLIST_CRITIQUE",
        "IMPLEMENTATION_PLAN",
        "PLAN_CRITIQUE",
        "INVESTIGATION",
        "SYSTEM_MODEL",
        "SOLUTION_DESIGN",
        "SOLUTION_CRITIQUE",
        "PROBLEM_ALIGNMENT",
        "SELF_REVIEW"
      ]
    },
    "remediation_type": {
      "enum": [
        "NONE",
        "MECHANICAL",
        "CHECKLIST_CHANGE",
        "PLAN_CHANGE",
        "SOLUTION_CHANGE",
        "MODEL_CHANGE",
        "INVESTIGATION",
        "PROBLEM_REALIGNMENT",
        "REVIEW_CORRECTION"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
