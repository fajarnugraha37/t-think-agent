{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/technical-review/technical-review-check.schema.json",
  "title": "Technical Review Check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "technical_check_id",
    "technical_review_run_id",
    "reviewer_id",
    "dimension",
    "source_self_review_check_ids",
    "target_ids",
    "procedure",
    "expected",
    "observed",
    "outcome",
    "evidence_refs",
    "independent_reasoning",
    "alternatives_considered",
    "self_review_disposition",
    "limitations"
  ],
  "properties": {
    "technical_check_id": {
      "type": "string",
      "pattern": "^TRCHK-"
    },
    "technical_review_run_id": {
      "type": "string",
      "pattern": "^TREV-"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "enum": [
        "ARCHITECTURE_CONFORMANCE",
        "FUNCTIONAL_CORRECTNESS",
        "CHECKLIST_AND_SCOPE_CONFORMANCE",
        "API_AND_CONTRACT_COMPATIBILITY",
        "DATA_MODEL_AND_TRANSACTIONAL_INTEGRITY",
        "CONCURRENCY_AND_IDEMPOTENCY",
        "SECURITY_AND_PRIVACY",
        "ERROR_HANDLING",
        "RESILIENCE_AND_FAILURE_MODES",
        "PERFORMANCE_AND_RESOURCE_USE",
        "OBSERVABILITY",
        "OPERABILITY",
        "MIGRATION_AND_DEPLOYMENT",
        "ROLLBACK_AND_RECOVERY",
        "TEST_STRATEGY",
        "DEPENDENCY_AND_SUPPLY_CHAIN",
        "MAINTAINABILITY",
        "CODE_QUALITY",
        "EVIDENCE_QUALITY",
        "SELF_REVIEW_CHALLENGE"
      ]
    },
    "source_self_review_check_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRCHK-"
      }
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "procedure": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE",
        "INCONCLUSIVE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independent_reasoning": {
      "type": "string",
      "minLength": 1
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "self_review_disposition": {
      "enum": [
        "AGREE",
        "DISAGREE",
        "PARTIAL",
        "NOT_APPLICABLE"
      ]
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
