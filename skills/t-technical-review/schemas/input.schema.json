{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/technical-review/input.schema.json",
  "title": "Technical Review Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "source_authorization",
    "source_artifacts",
    "review_controls"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical_review_run_id",
        "version",
        "created_at",
        "coordinator_agent",
        "language"
      ],
      "properties": {
        "technical_review_run_id": {
          "type": "string",
          "pattern": "^TREV-"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "coordinator_agent": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_review_contract_id",
        "self_review_bundle_digest",
        "self_review_run_id",
        "gate_status",
        "implementation_result_contract_id",
        "implementation_bundle_digest",
        "approved_checklist_contract_id",
        "repository_after_tree_digest"
      ],
      "properties": {
        "self_review_contract_id": {
          "type": "string",
          "pattern": "^SRCON-"
        },
        "self_review_bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "self_review_run_id": {
          "type": "string",
          "pattern": "^SREV-"
        },
        "gate_status": {
          "const": "READY_FOR_TECHNICAL_REVIEW"
        },
        "implementation_result_contract_id": {
          "type": "string",
          "pattern": "^IMPLCON-"
        },
        "implementation_bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approved_checklist_contract_id": {
          "type": "string",
          "pattern": "^CHKCON-"
        },
        "repository_after_tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_review_output",
        "self_review_result_contract",
        "bounded_output",
        "implementation_result_contract",
        "approved_checklist_contract",
        "checklist_items",
        "change_records",
        "verification_results",
        "repository_after",
        "evidence_ledger",
        "self_review_checks",
        "self_review_conformance",
        "self_review_audits",
        "self_review_findings",
        "self_review_directives"
      ],
      "properties": {
        "self_review_output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
