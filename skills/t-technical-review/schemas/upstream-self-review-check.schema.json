{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/self-review/review-check.schema.json",
  "title": "Self Review Check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_check_id",
    "self_review_run_id",
    "dimension",
    "target_ids",
    "procedure",
    "expected",
    "observed",
    "outcome",
    "evidence_refs",
    "reviewer_reasoning",
    "limitations"
  ],
  "properties": {
    "review_check_id": {
      "type": "string",
      "pattern": "^SRCHK-"
    },
    "self_review_run_id": {
      "type": "string",
      "pattern": "^SREV-"
    },
    "dimension": {
      "enum": [
        "CORRECTNESS",
        "CHECKLIST_CONFORMANCE",
        "SCOPE_INTEGRITY",
        "SEMANTIC_CONFORMANCE",
        "CHANGE_SURFACE",
        "DEPENDENCY_ORDER",
        "HUMAN_GATES",
        "ERROR_HANDLING",
        "SECURITY",
        "DATA_INTEGRITY",
        "CONCURRENCY",
        "COMPATIBILITY",
        "MIGRATION",
        "OBSERVABILITY",
        "TEST_ADEQUACY",
        "ROLLBACK_READINESS",
        "MAINTAINABILITY"
      ]
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "procedure": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE",
        "INCONCLUSIVE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewer_reasoning": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
