{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/technical-review/review-assignment.schema.json",
  "title": "Technical Review Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment_id",
    "technical_review_run_id",
    "reviewer_id",
    "reviewer_type",
    "reviewer_role",
    "assigned_at",
    "independence",
    "required_competencies",
    "declared_competencies",
    "review_scope"
  ],
  "properties": {
    "assignment_id": {
      "type": "string",
      "pattern": "^TRA-"
    },
    "technical_review_run_id": {
      "type": "string",
      "pattern": "^TREV-"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_type": {
      "enum": [
        "HUMAN",
        "AGENT"
      ]
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_implementation_author",
        "not_self_reviewer",
        "no_unresolved_conflict",
        "conflicting_identity_ids",
        "declaration"
      ],
      "properties": {
        "not_implementation_author": {
          "const": true
        },
        "not_self_reviewer": {
          "const": true
        },
        "no_unresolved_conflict": {
          "const": true
        },
        "conflicting_identity_ids": {
          "type": "array",
          "maxItems": 0
        },
        "declaration": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required_competencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "declared_competencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
