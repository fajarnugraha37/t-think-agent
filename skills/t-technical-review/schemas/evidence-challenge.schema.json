{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/technical-review/evidence-challenge.schema.json",
  "title": "Technical Review Evidence Challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_id",
    "technical_review_run_id",
    "reviewer_id",
    "target_type",
    "target_id",
    "challenge_type",
    "hypothesis",
    "procedure",
    "evidence_refs",
    "resolution",
    "impact",
    "finding_ids",
    "rationale"
  ],
  "properties": {
    "challenge_id": {
      "type": "string",
      "pattern": "^TRCH-"
    },
    "technical_review_run_id": {
      "type": "string",
      "pattern": "^TREV-"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "target_type": {
      "enum": [
        "SELF_REVIEW_CHECK",
        "CONFORMANCE_RESULT",
        "EVIDENCE_AUDIT",
        "SELF_REVIEW_RESULT_CONTRACT"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "challenge_type": {
      "enum": [
        "REPLAY",
        "COUNTEREXAMPLE",
        "BOUNDARY_CASE",
        "ALTERNATIVE_EXPLANATION",
        "EVIDENCE_PROVENANCE"
      ]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "procedure": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolution": {
      "enum": [
        "CONFIRMED",
        "REFUTED",
        "INCONCLUSIVE"
      ]
    },
    "impact": {
      "enum": [
        "NONE",
        "FINDING_REQUIRED",
        "UPSTREAM_REVIEW_REQUIRED"
      ]
    },
    "finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TRF-"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
