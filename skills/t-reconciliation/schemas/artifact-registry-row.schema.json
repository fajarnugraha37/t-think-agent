{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/reconciliation/artifact-registry-row.schema.json",
  "title": "artifact-registry-row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "reconciliation_run_id",
    "phase",
    "artifact_role",
    "canonical",
    "path",
    "format",
    "digest",
    "exists",
    "readable",
    "source_run_id",
    "source_contract_id",
    "lifecycle_status",
    "repository_tree_digest",
    "supersedes_artifact_ids",
    "epistemic_status",
    "limitations"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ART-[0-9]{3,}$"
    },
    "reconciliation_run_id": {
      "type": "string",
      "pattern": "^REC-[A-Za-z0-9._-]+$"
    },
    "phase": {
      "enum": [
        "PROBLEM_ALIGNMENT",
        "INVESTIGATION",
        "SYSTEM_MODEL",
        "MODEL_CRITIQUE",
        "SOLUTION_DESIGN",
        "SOLUTION_CRITIQUE",
        "IMPLEMENTATION_PLAN",
        "PLAN_CRITIQUE",
        "IMPLEMENTATION_CHECKLIST",
        "CHECKLIST_CRITIQUE",
        "BOUNDED_IMPLEMENTATION",
        "SELF_REVIEW",
        "TECHNICAL_REVIEW",
        "VERIFICATION"
      ]
    },
    "artifact_role": {
      "enum": [
        "PRIMARY_OUTPUT",
        "RESULT_CONTRACT",
        "EVIDENCE_LEDGER",
        "TRACEABILITY",
        "DECISION",
        "REPORT",
        "SOURCE_SNAPSHOT"
      ]
    },
    "canonical": {
      "type": "boolean"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "enum": [
        "YAML",
        "JSON",
        "JSONL",
        "CSV",
        "MARKDOWN",
        "BINARY"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exists": {
      "const": true
    },
    "readable": {
      "const": true
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_contract_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle_status": {
      "type": "string",
      "minLength": 1
    },
    "repository_tree_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ART-[0-9]{3,}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "epistemic_status": {
      "enum": [
        "FACT",
        "INFERENCE",
        "ASSUMPTION",
        "UNKNOWN",
        "CONFLICT"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
