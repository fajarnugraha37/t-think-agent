{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/verification/evidence.schema.json",
  "title": "Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "verification_run_id",
    "evidence_type",
    "producer_id",
    "captured_at",
    "locator",
    "content_digest",
    "source_execution_ids",
    "source_falsification_ids",
    "redacted",
    "reproducible"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^VE-[0-9]{3,}$"
    },
    "verification_run_id": {
      "type": "string",
      "pattern": "^VER-"
    },
    "evidence_type": {
      "enum": [
        "ENVIRONMENT_SNAPSHOT",
        "COMMAND_OUTPUT",
        "TEST_REPORT",
        "RUNTIME_OBSERVATION",
        "STATIC_ANALYSIS",
        "MANUAL_INSPECTION",
        "SECURITY_REPORT",
        "PERFORMANCE_REPORT",
        "ROLLBACK_REPORT"
      ]
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_execution_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^VEXEC-"
      }
    },
    "source_falsification_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^VFAL-"
      }
    },
    "redacted": {
      "type": "boolean"
    },
    "reproducible": {
      "type": "boolean"
    }
  }
}
