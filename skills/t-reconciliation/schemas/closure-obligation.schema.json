{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/reconciliation/closure-obligation.schema.json",
  "title": "closure-obligation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "closure_id",
    "reconciliation_run_id",
    "root_node_id",
    "root_type",
    "required_terminal_types",
    "observed_terminal_node_ids",
    "path_link_ids",
    "closure_status",
    "evidence_ids",
    "rationale",
    "required_route",
    "blocking"
  ],
  "properties": {
    "closure_id": {
      "type": "string",
      "pattern": "^CLO-[0-9]{3,}$"
    },
    "reconciliation_run_id": {
      "type": "string",
      "pattern": "^REC-[A-Za-z0-9._-]+$"
    },
    "root_node_id": {
      "type": "string",
      "pattern": "^TN-[0-9]{3,}$"
    },
    "root_type": {
      "enum": [
        "PROBLEM",
        "ACCEPTANCE_CRITERION",
        "INVARIANT",
        "RISK"
      ]
    },
    "required_terminal_types": {
      "type": "array",
      "items": {
        "enum": [
          "CHANGE",
          "TEST",
          "VERIFICATION_OBLIGATION",
          "REVIEW_RESULT"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "observed_terminal_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TN-[0-9]{3,}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "path_link_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TL-[0-9]{3,}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "closure_status": {
      "enum": [
        "CLOSED",
        "ACCEPTED_RISK",
        "OPEN",
        "BLOCKED",
        "CONFLICT"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(VE|F|INF|INV|TN)-[A-Za-z0-9._-]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "required_route": {
      "enum": [
        "RECONCILIATION",
        "VERIFICATION",
        "TECHNICAL_REVIEW",
        "SELF_REVIEW",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_CHECKLIST",
        "CHECKLIST_CRITIQUE",
        "IMPLEMENTATION_PLAN",
        "PLAN_CRITIQUE",
        "SOLUTION_CRITIQUE",
        "SOLUTION_DESIGN",
        "MODEL_CRITIQUE",
        "SYSTEM_MODEL",
        "INVESTIGATION",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "blocking": {
      "type": "boolean"
    }
  }
}
