{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "lane",
    "status",
    "next_state",
    "missing_phases",
    "unsatisfied_criteria",
    "residual_risks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "enum": [
        "quick",
        "standard",
        "full"
      ]
    },
    "status": {
      "enum": [
        "RECONCILED_COMPLETE",
        "RETURN_REQUIRED",
        "BLOCKED"
      ]
    },
    "next_state": {
      "enum": [
        "COMPLETED",
        "RECONCILIATION",
        "VERIFICATION",
        "IMPLEMENTATION_REVIEW",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_BLUEPRINT",
        "SOLUTION_DESIGN",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "missing_phases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "unsatisfied_criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
