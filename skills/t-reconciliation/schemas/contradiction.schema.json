{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/reconciliation/contradiction.schema.json",
  "title": "contradiction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contradiction_id",
    "reconciliation_run_id",
    "artifact_ids",
    "node_ids",
    "category",
    "description",
    "evidence_ids",
    "severity",
    "status",
    "resolution",
    "required_route",
    "blocking"
  ],
  "properties": {
    "contradiction_id": {
      "type": "string",
      "pattern": "^CON-[0-9]{3,}$"
    },
    "reconciliation_run_id": {
      "type": "string",
      "pattern": "^REC-[A-Za-z0-9._-]+$"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ART-[0-9]{3,}$"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TN-[0-9]{3,}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "category": {
      "enum": [
        "DIGEST_MISMATCH",
        "STATUS_CONFLICT",
        "SEMANTIC_CONFLICT",
        "TRACEABILITY_CONFLICT",
        "REPOSITORY_STATE_CONFLICT",
        "DECISION_CONFLICT"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(VE|F|INF|INV|TN)-[A-Za-z0-9._-]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "ACCEPTED_RISK"
      ]
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_route": {
      "enum": [
        "RECONCILIATION",
        "VERIFICATION",
        "TECHNICAL_REVIEW",
        "SELF_REVIEW",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_CHECKLIST",
        "CHECKLIST_CRITIQUE",
        "IMPLEMENTATION_PLAN",
        "PLAN_CRITIQUE",
        "SOLUTION_CRITIQUE",
        "SOLUTION_DESIGN",
        "MODEL_CRITIQUE",
        "SYSTEM_MODEL",
        "INVESTIGATION",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "blocking": {
      "type": "boolean"
    }
  }
}
