{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "lane",
    "phase_artifacts",
    "acceptance_criteria",
    "implementation_review_status",
    "verification_status",
    "open_blocking_findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "enum": [
        "quick",
        "standard",
        "full"
      ]
    },
    "phase_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "ref",
          "sha256"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SATISFIED",
              "UNSATISFIED",
              "BLOCKED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "implementation_review_status": {
      "const": "READY_FOR_VERIFICATION"
    },
    "verification_status": {
      "const": "READY_FOR_RECONCILIATION"
    },
    "open_blocking_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
