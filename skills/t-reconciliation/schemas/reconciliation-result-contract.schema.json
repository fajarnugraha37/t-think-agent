{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/reconciliation/reconciliation-result-contract.schema.json",
  "title": "reconciliation-result-contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "status",
    "reconciliation_run_id",
    "assignment_id",
    "source_verification_contract_id",
    "source_verification_bundle_digest",
    "source_repository_tree_digest",
    "reconciliation_bundle_digest",
    "artifact_ids",
    "trace_node_ids",
    "trace_link_ids",
    "closure_ids",
    "contradiction_ids",
    "gap_ids",
    "approval_id",
    "verdict",
    "integrity",
    "limitations"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^RCON-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "RECONCILED",
        "BLOCKED",
        "AWAITING_HUMAN_APPROVAL"
      ]
    },
    "reconciliation_run_id": {
      "type": "string",
      "pattern": "^REC-[A-Za-z0-9._-]+$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^RA-[0-9]{3,}$"
    },
    "source_verification_contract_id": {
      "type": "string",
      "pattern": "^VCON-[0-9]{3,}$"
    },
    "source_verification_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_repository_tree_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reconciliation_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ART-[0-9]{3,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "trace_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TN-[0-9]{3,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "trace_link_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TL-[0-9]{3,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "closure_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CLO-[0-9]{3,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "contradiction_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CON-[0-9]{3,}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^GAP-[0-9]{3,}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RAPP-[0-9]{3,}$"
    },
    "verdict": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.local/reconciliation/verdict.schema.json",
      "title": "verdict",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "next_state",
        "rationale",
        "blocking_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "RECONCILED_COMPLETE",
            "AWAITING_HUMAN_CLOSURE",
            "LOOPBACK_REQUIRED",
            "BLOCKED"
          ]
        },
        "next_state": {
          "enum": [
            "COMPLETED",
            "RECONCILIATION",
            "VERIFICATION",
            "TECHNICAL_REVIEW",
            "SELF_REVIEW",
            "BOUNDED_IMPLEMENTATION",
            "IMPLEMENTATION_CHECKLIST",
            "CHECKLIST_CRITIQUE",
            "IMPLEMENTATION_PLAN",
            "PLAN_CRITIQUE",
            "SOLUTION_CRITIQUE",
            "SOLUTION_DESIGN",
            "MODEL_CRITIQUE",
            "SYSTEM_MODEL",
            "INVESTIGATION",
            "PROBLEM_ALIGNMENT"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "blocking_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "integrity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.local/reconciliation/integrity.schema.json",
      "title": "integrity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_bundle_verified",
        "all_phases_present",
        "artifact_digests_valid",
        "traceability_complete",
        "closure_complete",
        "contradictions_resolved",
        "gaps_resolved_or_accepted",
        "repository_unchanged",
        "human_closure_approved",
        "no_silent_mutation"
      ],
      "properties": {
        "source_bundle_verified": {
          "type": "boolean"
        },
        "all_phases_present": {
          "type": "boolean"
        },
        "artifact_digests_valid": {
          "type": "boolean"
        },
        "traceability_complete": {
          "type": "boolean"
        },
        "closure_complete": {
          "type": "boolean"
        },
        "contradictions_resolved": {
          "type": "boolean"
        },
        "gaps_resolved_or_accepted": {
          "type": "boolean"
        },
        "repository_unchanged": {
          "type": "boolean"
        },
        "human_closure_approved": {
          "type": "boolean"
        },
        "no_silent_mutation": {
          "type": "boolean"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
