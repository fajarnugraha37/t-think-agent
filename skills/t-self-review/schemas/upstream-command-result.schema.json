{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/bounded-implementation/command-result.schema.json",
  "title": "Command Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "implementation_run_id",
    "checklist_ids",
    "purpose",
    "command",
    "working_directory",
    "started_at",
    "completed_at",
    "exit_code",
    "status",
    "stdout_digest",
    "stderr_digest",
    "output_excerpt",
    "evidence_path"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^CMD-"
    },
    "implementation_run_id": {
      "type": "string",
      "pattern": "^BIMPL-"
    },
    "checklist_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^CHK-"
      },
      "uniqueItems": true
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "SKIPPED"
      ]
    },
    "stdout_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stderr_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output_excerpt": {
      "type": "string"
    },
    "evidence_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
