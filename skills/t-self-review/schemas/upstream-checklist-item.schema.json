{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/checklist-builder/checklist-item.schema.json",
  "title": "Atomic Implementation Checklist Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checklist_id",
    "title",
    "status",
    "action_type",
    "source_plan_id",
    "source_operation",
    "planning_target_ids",
    "problem_ids",
    "model_ids",
    "evidence_ids",
    "invariant_ids",
    "scope",
    "preconditions",
    "action",
    "expected_result",
    "verification_item_ids",
    "rollback_item_ids",
    "risk_ids",
    "dependency_checklist_ids",
    "atomicity",
    "semantic_guard",
    "execution",
    "completion_evidence",
    "failure_conditions",
    "on_ambiguity",
    "on_unapproved_change"
  ],
  "properties": {
    "checklist_id": {
      "type": "string",
      "pattern": "^CHK-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY_FOR_REVIEW",
        "BLOCKED",
        "SUPERSEDED"
      ]
    },
    "action_type": {
      "enum": [
        "CODE_EDIT",
        "DATABASE_SCHEMA_CHANGE",
        "DATA_OPERATION",
        "CONFIGURATION_CHANGE",
        "DEPLOYMENT_ACTION",
        "MIGRATION_ACTION",
        "TEST_CREATION",
        "OBSERVABILITY_CHANGE",
        "SECURITY_CONTROL",
        "DOCUMENTATION_CHANGE",
        "OPERATIONS_ACTION",
        "EXECUTION_GUARD"
      ]
    },
    "source_plan_id": {
      "type": "string",
      "pattern": "^PLN-"
    },
    "source_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operation",
        "expected_effect",
        "non_goals",
        "digest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "expected_effect": {
          "type": "string",
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "planning_target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PTGT-"
      }
    },
    "problem_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(PS|PE|AC)-"
      }
    },
    "model_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MDL-"
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(F|INF|ASM|UNK|CON|INV|RSK)-"
      }
    },
    "invariant_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(INV|MDL)-"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "files_or_artifacts"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files_or_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "object",
        "location",
        "exact_change",
        "non_goals"
      ],
      "properties": {
        "verb": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "exact_change": {
          "type": "string",
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_result": {
      "type": "string",
      "minLength": 1
    },
    "verification_item_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TST-"
      }
    },
    "rollback_item_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RBK-"
      }
    },
    "risk_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(RSK|SRSK)-"
      }
    },
    "dependency_checklist_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CHK-"
      }
    },
    "atomicity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_primary_action",
        "one_source_operation",
        "independently_verifiable",
        "independently_reversible",
        "atomicity_rationale"
      ],
      "properties": {
        "single_primary_action": {
          "const": true
        },
        "one_source_operation": {
          "const": true
        },
        "independently_verifiable": {
          "const": true
        },
        "independently_reversible": {
          "type": "boolean"
        },
        "atomicity_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "introduces_new_semantic_decision",
        "within_approved_plan",
        "scope_expansion",
        "deviations"
      ],
      "properties": {
        "introduces_new_semantic_decision": {
          "const": false
        },
        "within_approved_plan": {
          "const": true
        },
        "scope_expansion": {
          "const": false
        },
        "deviations": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_order",
        "operation_order",
        "global_sequence",
        "parallel_group",
        "requires_human_action",
        "human_action_reason"
      ],
      "properties": {
        "plan_order": {
          "type": "integer",
          "minimum": 1
        },
        "operation_order": {
          "type": "integer",
          "minimum": 1
        },
        "global_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "parallel_group": {
          "type": "string",
          "pattern": "^LEVEL-[0-9]{3,}$"
        },
        "requires_human_action": {
          "type": "boolean"
        },
        "human_action_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "completion_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "on_ambiguity": {
      "const": "IMPLEMENTATION_FAILED"
    },
    "on_unapproved_change": {
      "const": "LOOPBACK_REQUIRED"
    }
  }
}
