{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/self-review/evidence-audit.schema.json",
  "title": "Evidence Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "self_review_run_id",
    "artifact_kind",
    "artifact_id",
    "source_path",
    "expected_digest",
    "actual_digest",
    "digest_verified",
    "existence_verified",
    "content_inspected",
    "evidence_refs",
    "outcome",
    "notes"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "pattern": "^SRAUD-"
    },
    "self_review_run_id": {
      "type": "string",
      "pattern": "^SREV-"
    },
    "artifact_kind": {
      "enum": [
        "BOUNDED_OUTPUT",
        "IMPLEMENTATION_CONTRACT",
        "CHECKLIST_CONTRACT",
        "CHECKLIST_ITEMS",
        "EXECUTION_RECORDS",
        "CHANGE_RECORDS",
        "COMMAND_RESULTS",
        "VERIFICATION_RESULTS",
        "ROLLBACK_RESULTS",
        "IMPLEMENTATION_FINDINGS",
        "REPOSITORY_BEFORE",
        "REPOSITORY_AFTER",
        "EVIDENCE_LEDGER"
      ]
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "expected_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actual_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest_verified": {
      "type": "boolean"
    },
    "existence_verified": {
      "type": "boolean"
    },
    "content_inspected": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
