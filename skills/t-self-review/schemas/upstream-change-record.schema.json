{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/bounded-implementation/change-record.schema.json",
  "title": "Change Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "implementation_run_id",
    "checklist_id",
    "path",
    "change_type",
    "before_digest",
    "after_digest",
    "diff_digest",
    "summary",
    "decision_origin",
    "within_approved_scope",
    "semantic_decision_introduced",
    "evidence_refs"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "pattern": "^CHG-"
    },
    "implementation_run_id": {
      "type": "string",
      "pattern": "^BIMPL-"
    },
    "checklist_id": {
      "type": "string",
      "pattern": "^CHK-"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "change_type": {
      "enum": [
        "CREATE",
        "MODIFY",
        "DELETE",
        "RENAME",
        "DATA_MUTATION",
        "DEPLOYMENT_STATE_CHANGE",
        "NO_FILE_CHANGE"
      ]
    },
    "before_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "after_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "diff_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "decision_origin": {
      "const": "APPROVED_CHECKLIST"
    },
    "within_approved_scope": {
      "const": true
    },
    "semantic_decision_introduced": {
      "const": false
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
