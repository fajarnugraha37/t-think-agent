            }
          }
        }
      }
    },
    "review_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_second_pass",
        "inspect_actual_diff",
        "replay_or_recheck_verification",
        "require_all_dimensions",
        "stop_on_source_drift",
        "allow_code_changes"
      ],
      "properties": {
        "independent_second_pass": {
          "const": true
        },
        "inspect_actual_diff": {
          "const": true
        },
        "replay_or_recheck_verification": {
          "type": "boolean"
        },
        "require_all_dimensions": {
          "const": true
        },
        "stop_on_source_drift": {
          "const": true
        },
        "allow_code_changes": {
          "const": false
        }
      }
