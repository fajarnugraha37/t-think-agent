{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/self-review/input.schema.json",
  "title": "Self Review Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "source_authorization",
    "source_artifacts",
    "review_controls"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_review_run_id",
        "version",
        "created_at",
        "reviewer_agent",
        "language"
      ],
      "properties": {
        "self_review_run_id": {
          "type": "string",
          "pattern": "^SREV-"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer_agent": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_result_contract_id",
        "implementation_bundle_digest",
        "bounded_implementation_run_id",
        "gate_status",
        "repository_after_tree_digest"
      ],
      "properties": {
        "implementation_result_contract_id": {
          "type": "string",
          "pattern": "^IMPLCON-"
        },
        "implementation_bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bounded_implementation_run_id": {
          "type": "string",
          "pattern": "^BIMPL-"
        },
        "gate_status": {
          "const": "READY_FOR_SELF_REVIEW"
        },
        "repository_after_tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_output",
        "implementation_result_contract",
        "approved_checklist_contract",
        "checklist_items",
        "execution_records",
        "change_records",
        "command_results",
        "verification_results",
        "rollback_results",
        "implementation_findings",
        "repository_before",
        "repository_after",
        "evidence_ledger"
      ],
      "properties": {
        "bounded_output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "implementation_result_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "approved_checklist_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "checklist_items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
