{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "lane",
    "phase",
    "track",
    "reviewer_agent",
    "invocation_id",
    "implementation",
    "diff",
    "boundary_report",
    "required_categories"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "enum": [
        "quick",
        "standard",
        "full"
      ]
    },
    "phase": {
      "const": "IMPLEMENTATION_REVIEW"
    },
    "track": {
      "const": "self_review"
    },
    "reviewer_agent": {
      "const": "t-builder"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "boundary_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "blueprint": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "sha256"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "required_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "BLUEPRINT_CONFORMANCE",
          "SCOPE_INTEGRITY",
          "TEST_INTEGRITY",
          "DOCUMENTATION_IMPACT",
          "ROLLBACK_READINESS",
          "UNRELATED_CHANGE"
        ]
      }
    }
  }
}
