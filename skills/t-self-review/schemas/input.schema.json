                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "change_records": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
