{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(F|INF|ASM|UNK|CON|INV|RSK)-"
    },
    "type": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
