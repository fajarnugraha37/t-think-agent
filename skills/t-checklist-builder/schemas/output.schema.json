{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/checklist-builder/output.schema.json",
  "title": "Checklist Builder Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "source_plan_contract",
    "artifact_files",
    "checklist_summary",
    "coverage_summary",
    "dependency_analysis",
    "atomicity_assessment",
    "source_reconciliation",
    "execution_readiness",
    "finding_summary",
    "gate_decision",
    "limitations"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder_run_id",
        "version",
        "status",
        "created_at",
        "updated_at",
        "author_agent"
      ],
      "properties": {
        "builder_run_id": {
          "type": "string",
          "pattern": "^CBLD-"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "COMPLETE",
            "BLOCKED"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "author_agent": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_plan_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "source_planning_run_id",
        "source_solution_contract_id",
        "plan_bundle_digest",
        "repository_commit",
        "status"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^PLANCON-"
        },
        "source_planning_run_id": {
          "type": "string",
          "pattern": "^IPLAN-"
        },
        "source_solution_contract_id": {
          "type": "string",
          "pattern": "^SOLCON-"
        },
        "plan_bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "status": {
          "const": "APPROVED"
        }
      }
    },
    "artifact_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checklist_items",
        "dependency_edges",
        "coverage_matrix",
        "execution_batches",
        "findings",
        "report"
      ],
      "properties": {
        "checklist_items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dependency_edges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "coverage_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "execution_batches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "checklist_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_items",
        "ready_for_review",
        "blocked",
        "action_type_counts",
        "human_action_items"
      ],
      "properties": {
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "ready_for_review": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "action_type_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "human_action_items": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHK-"
          }
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_plan_operations",
        "fully_covered_operations",
        "partially_covered_operations",
        "uncovered_operations",
        "duplicate_covered_operations",
        "all_plan_operations_exactly_once"
      ],
      "properties": {
        "total_plan_operations": {
          "type": "integer",
          "minimum": 0
        },
        "fully_covered_operations": {
          "type": "integer",
          "minimum": 0
        },
        "partially_covered_operations": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered_operations": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_covered_operations": {
          "type": "integer",
          "minimum": 0
        },
        "all_plan_operations_exactly_once": {
          "type": "boolean"
        }
      }
    },
    "dependency_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acyclic",
        "all_references_valid",
        "root_checklist_ids",
        "leaf_checklist_ids",
        "topological_order",
        "parallel_levels"
      ],
      "properties": {
        "acyclic": {
          "type": "boolean"
        },
        "all_references_valid": {
          "type": "boolean"
        },
        "root_checklist_ids": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHK-"
          }
        },
        "leaf_checklist_ids": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHK-"
          }
        },
        "topological_order": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHK-"
          }
        },
        "parallel_levels": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CHK-"
            }
          }
        }
      }
    },
    "atomicity_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_single_primary_action",
        "all_one_source_operation",
        "all_independently_verifiable",
        "semantic_decisions_detected",
        "scope_expansions_detected",
        "non_atomic_item_ids",
        "status"
      ],
      "properties": {
        "all_single_primary_action": {
          "type": "boolean"
        },
        "all_one_source_operation": {
          "type": "boolean"
        },
        "all_independently_verifiable": {
          "type": "boolean"
        },
        "semantic_decisions_detected": {
          "type": "boolean"
        },
        "scope_expansions_detected": {
          "type": "boolean"
        },
        "non_atomic_item_ids": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHK-"
          }
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "source_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_contract_valid",
        "plan_bundle_digest_valid",
        "exact_plan_item_set",
        "exact_operation_coverage",
        "exact_verification_set",
        "exact_rollback_set",
        "approved_change_surface_only",
        "status"
      ],
      "properties": {
        "approved_contract_valid": {
          "type": "boolean"
        },
        "plan_bundle_digest_valid": {
          "type": "boolean"
        },
        "exact_plan_item_set": {
          "type": "boolean"
        },
        "exact_operation_coverage": {
          "type": "boolean"
        },
        "exact_verification_set": {
          "type": "boolean"
        },
        "exact_rollback_set": {
          "type": "boolean"
        },
        "approved_change_surface_only": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "execution_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_preconditions_explicit",
        "all_items_have_verification",
        "all_planned_rollbacks_mapped",
        "human_gates_explicit",
        "batch_plan_matches_dependency_levels",
        "status"
      ],
      "properties": {
        "all_preconditions_explicit": {
          "type": "boolean"
        },
        "all_items_have_verification": {
          "type": "boolean"
        },
        "all_planned_rollbacks_mapped": {
          "type": "boolean"
        },
        "human_gates_explicit": {
          "type": "boolean"
        },
        "batch_plan_matches_dependency_levels": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "READY",
            "NOT_READY"
          ]
        }
      }
    },
    "finding_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "blocking",
        "by_type",
        "blocking_finding_ids"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "integer",
          "minimum": 0
        },
        "by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "blocking_finding_ids": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CBFND-"
          }
        }
      }
    },
    "gate_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale",
        "blocking_finding_ids",
        "required_next_actions",
        "next_state"
      ],
      "properties": {
        "status": {
          "enum": [
            "READY_FOR_CHECKLIST_CRITIQUE",
            "RETURN_TO_IMPLEMENTATION_PLAN",
            "RETURN_TO_PLAN_CRITIQUE",
            "RETURN_TO_INVESTIGATION",
            "RETURN_TO_SYSTEM_MODEL",
            "RETURN_TO_SOLUTION_DESIGN",
            "RETURN_TO_SOLUTION_CRITIQUE",
            "RETURN_TO_PROBLEM_ALIGNMENT",
            "BLOCKED"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "blocking_finding_ids": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CBFND-"
          }
        },
        "required_next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_state": {
          "enum": [
            "CHECKLIST_CRITIQUE",
            "IMPLEMENTATION_CHECKLIST",
            "IMPLEMENTATION_PLAN",
            "PLAN_CRITIQUE",
            "INVESTIGATION",
            "SYSTEM_MODEL",
            "SOLUTION_DESIGN",
            "SOLUTION_CRITIQUE",
            "PROBLEM_ALIGNMENT"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
