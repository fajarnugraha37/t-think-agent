              "minLength": 1
            }
          }
        }
      }
    },
    "builder_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomicity_required",
        "one_source_operation_per_item",
        "exact_operation_coverage_required",
        "new_semantic_decisions_allowed",
        "implementation_allowed",
        "scope_expansion_allowed",
        "dependency_dag_required",
        "verification_mapping_required",
        "rollback_mapping_required_when_planned",
        "ambiguity_behavior"
      ],
      "properties": {
        "atomicity_required": {
          "const": true
        },
        "one_source_operation_per_item": {
          "const": true
        },
        "exact_operation_coverage_required": {
          "const": true
        },
        "new_semantic_decisions_allowed": {
          "const": false
        },
        "implementation_allowed": {
          "const": false
        },
        "scope_expansion_allowed": {
          "const": false
        },
        "dependency_dag_required": {
          "const": true
        },
        "verification_mapping_required": {
          "const": true
        },
        "rollback_mapping_required_when_planned": {
          "const": true
        },
        "ambiguity_behavior": {
