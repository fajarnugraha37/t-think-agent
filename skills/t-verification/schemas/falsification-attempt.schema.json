{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/verification/falsification-attempt.schema.json",
  "title": "Falsification Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "falsification_id",
    "verification_run_id",
    "obligation_id",
    "hypothesis",
    "method",
    "counterexample_or_boundary",
    "execution_ids",
    "evidence_ids",
    "resolution",
    "impact",
    "limitations"
  ],
  "properties": {
    "falsification_id": {
      "type": "string",
      "pattern": "^VFAL-[0-9]{3,}$"
    },
    "verification_run_id": {
      "type": "string",
      "pattern": "^VER-"
    },
    "obligation_id": {
      "type": "string",
      "pattern": "^VOB-"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "COUNTEREXAMPLE",
        "BOUNDARY_ANALYSIS",
        "FAULT_INJECTION",
        "CONCURRENCY_STRESS",
        "NEGATIVE_TEST",
        "REPLAY",
        "ALTERNATIVE_EXPLANATION",
        "PROVENANCE_RECHECK"
      ]
    },
    "counterexample_or_boundary": {
      "type": "string",
      "minLength": 1
    },
    "execution_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^VEXEC-"
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^VE-"
      }
    },
    "resolution": {
      "enum": [
        "SURVIVED",
        "REFUTED",
        "INCONCLUSIVE"
      ]
    },
    "impact": {
      "enum": [
        "NONE",
        "NONBLOCKING",
        "BLOCKING"
      ]
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
