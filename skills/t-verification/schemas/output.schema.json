{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "lane",
    "results",
    "source_mutation",
    "status",
    "next_state",
    "required_route"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "enum": [
        "quick",
        "standard",
        "full"
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "command",
          "exit_code",
          "status",
          "evidence_ref"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_mutation": {
      "const": false
    },
    "status": {
      "enum": [
        "READY_FOR_RECONCILIATION",
        "RETURN_REQUIRED",
        "BLOCKED"
      ]
    },
    "next_state": {
      "enum": [
        "RECONCILIATION",
        "VERIFICATION",
        "IMPLEMENTATION_REVIEW",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_BLUEPRINT",
        "SOLUTION_DESIGN",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "required_route": {
      "enum": [
        "VERIFICATION",
        "IMPLEMENTATION_REVIEW",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_BLUEPRINT",
        "SOLUTION_DESIGN",
        "PROBLEM_ALIGNMENT",
        null
      ]
    }
  }
}
