{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/verification/environment.schema.json",
  "title": "Verification Environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment_id",
    "verification_run_id",
    "environment_type",
    "isolation",
    "repository",
    "build_artifact",
    "toolchain",
    "dependencies",
    "test_data",
    "time_control",
    "network_control",
    "secret_handling",
    "reproducibility",
    "captured_at",
    "evidence_ids"
  ],
  "properties": {
    "environment_id": {
      "type": "string",
      "pattern": "^VENV-"
    },
    "verification_run_id": {
      "type": "string",
      "pattern": "^VER-"
    },
    "environment_type": {
      "enum": [
        "LOCAL_ISOLATED",
        "CI_EPHEMERAL",
        "DEDICATED_TEST",
        "STAGING",
        "PRODUCTION_SHADOW"
      ]
    },
    "isolation": {
      "enum": [
        "EPHEMERAL",
        "DEDICATED",
        "SHARED_READ_ONLY"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "commit_sha",
        "tree_digest",
        "working_tree_status",
        "changed_paths"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "minLength": 7
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "working_tree_status": {
          "enum": [
            "CLEAN",
            "DIRTY"
          ]
        },
        "changed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "build_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "digest",
        "provenance"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version_or_digest",
          "availability"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version_or_digest": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "AVAILABLE",
              "EMULATED",
              "UNAVAILABLE"
            ]
          }
        }
      }
    },
    "test_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "digest",
        "resettable",
        "contains_production_data"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resettable": {
          "const": true
        },
        "contains_production_data": {
          "const": false
        }
      }
    },
    "time_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "clock_mode"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "clock_mode": {
          "enum": [
            "FIXED",
            "CONTROLLED",
            "REALTIME_RECORDED"
          ]
        }
      }
    },
    "network_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "external_calls_recorded"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ISOLATED",
            "ALLOWLISTED",
            "RECORDED"
          ]
        },
        "external_calls_recorded": {
          "const": true
        }
      }
    },
    "secret_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secrets_redacted",
        "secret_values_persisted"
      ],
      "properties": {
        "secrets_redacted": {
          "const": true
        },
        "secret_values_persisted": {
          "const": false
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reproducible",
        "setup_command",
        "teardown_command",
        "limitations"
      ],
      "properties": {
        "reproducible": {
          "const": true
        },
        "setup_command": {
          "type": "string",
          "minLength": 1
        },
        "teardown_command": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^VE-"
      }
    }
  }
}
