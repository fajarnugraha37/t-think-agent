{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/verification/remediation-directive.schema.json",
  "title": "Verification Remediation Directive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directive_id",
    "verification_run_id",
    "finding_id",
    "target_state",
    "status",
    "action",
    "acceptance_condition",
    "applied",
    "mutation_allowed_in_verification"
  ],
  "properties": {
    "directive_id": {
      "type": "string",
      "pattern": "^VRDIR-[0-9]{3,}$"
    },
    "verification_run_id": {
      "type": "string",
      "pattern": "^VER-"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^VRF-"
    },
    "target_state": {
      "enum": [
        "VERIFICATION",
        "TECHNICAL_REVIEW",
        "SELF_REVIEW",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_CHECKLIST",
        "CHECKLIST_CRITIQUE",
        "IMPLEMENTATION_PLAN",
        "PLAN_CRITIQUE",
        "INVESTIGATION",
        "SYSTEM_MODEL",
        "SOLUTION_DESIGN",
        "SOLUTION_CRITIQUE",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "status": {
      "const": "OPEN"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_condition": {
      "type": "string",
      "minLength": 1
    },
    "applied": {
      "const": false
    },
    "mutation_allowed_in_verification": {
      "const": false
    }
  }
}
