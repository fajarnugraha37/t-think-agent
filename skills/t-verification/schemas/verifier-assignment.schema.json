{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/verification/verifier-assignment.schema.json",
  "title": "Verifier Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment_id",
    "verification_run_id",
    "verifier_id",
    "role",
    "assigned_at",
    "prohibited_identity_ids",
    "declared_competencies",
    "required_competencies",
    "independence",
    "conflicts"
  ],
  "properties": {
    "assignment_id": {
      "type": "string",
      "pattern": "^VA-"
    },
    "verification_run_id": {
      "type": "string",
      "pattern": "^VER-"
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "const": "INDEPENDENT_VERIFIER"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "prohibited_identity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "declared_competencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_competencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_implementation_author",
        "not_self_reviewer",
        "not_technical_reviewer",
        "no_conflict"
      ],
      "properties": {
        "not_implementation_author": {
          "const": true
        },
        "not_self_reviewer": {
          "const": true
        },
        "not_technical_reviewer": {
          "const": true
        },
        "no_conflict": {
          "const": true
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 0
    }
  }
}
