{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/verification/verification-obligation.schema.json",
  "title": "Verification Obligation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "obligation_id",
    "verification_run_id",
    "source_verification_result_id",
    "source_verification_item_id",
    "checklist_ids",
    "problem_ids",
    "model_ids",
    "invariant_ids",
    "risk_ids",
    "source_evidence_ids",
    "verification_type",
    "dimension",
    "criticality",
    "applicability",
    "objective",
    "acceptance_criteria",
    "falsification_required",
    "required_environment_capabilities",
    "status"
  ],
  "properties": {
    "obligation_id": {
      "type": "string",
      "pattern": "^VOB-[0-9]{3,}$"
    },
    "verification_run_id": {
      "type": "string",
      "pattern": "^VER-"
    },
    "source_verification_result_id": {
      "type": "string",
      "pattern": "^VRES-"
    },
    "source_verification_item_id": {
      "type": "string",
      "pattern": "^TST-"
    },
    "checklist_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CHK-"
      }
    },
    "problem_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(PS|PE|AC)-"
      }
    },
    "model_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MDL-"
      }
    },
    "invariant_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(INV|MDL)-"
      }
    },
    "risk_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(RSK|SRSK)-"
      }
    },
    "source_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(F|INF|ASM|UNK|CON|INV|RSK)-"
      }
    },
    "verification_type": {
      "enum": [
        "UNIT",
        "INTEGRATION",
        "CONTRACT",
        "STATIC_ANALYSIS",
        "MIGRATION",
        "CONCURRENCY",
        "SECURITY",
        "OBSERVABILITY",
        "MANUAL_INSPECTION",
        "RUNTIME_PROBE"
      ]
    },
    "dimension": {
      "enum": [
        "FUNCTIONAL_ACCEPTANCE",
        "REGRESSION",
        "INVARIANT_PRESERVATION",
        "NEGATIVE_PATH",
        "ERROR_HANDLING",
        "CONCURRENCY_IDEMPOTENCY",
        "SECURITY",
        "DATA_INTEGRITY",
        "API_CONTRACT",
        "MIGRATION_COMPATIBILITY",
        "OBSERVABILITY",
        "ROLLBACK_RECOVERY",
        "PERFORMANCE_RESOURCE",
        "OPERABILITY",
        "EVIDENCE_REPRODUCIBILITY"
      ]
    },
    "criticality": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "applicability": {
      "enum": [
        "MANDATORY",
        "NOT_APPLICABLE"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsification_required": {
      "type": "boolean"
    },
    "required_environment_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED",
        "SUPERSEDED"
      ]
    }
  }
}
