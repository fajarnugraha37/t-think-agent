{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/model-critique/evidence-request.schema.json",
  "title": "Model Critique Evidence Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "trigger_critique_ids",
    "question",
    "why_needed",
    "required_sources",
    "search_scope",
    "acceptance_criteria",
    "blocking",
    "return_phase",
    "status"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^EREQ-[0-9]{3,}$"
    },
    "trigger_critique_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CRIT-[0-9]{3,}$"
      }
    },
    "question": {
      "type": "string",
      "minLength": 3
    },
    "why_needed": {
      "type": "string",
      "minLength": 3
    },
    "required_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "SOURCE_CODE",
          "TEST_SOURCE",
          "BUILD_CONFIG",
          "RUNTIME_CONFIG",
          "DEPLOYMENT_MANIFEST",
          "DATABASE_SCHEMA",
          "MIGRATION",
          "COMMAND_OUTPUT",
          "RUNTIME_LOG",
          "TRACE",
          "DATABASE_QUERY",
          "API_CONTRACT",
          "VERSION_HISTORY",
          "HUMAN_CLARIFICATION"
        ]
      }
    },
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "modules",
        "environments",
        "queries",
        "limitations"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking": {
      "type": "boolean"
    },
    "return_phase": {
      "enum": [
        "INVESTIGATION",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "SATISFIED",
        "CANCELLED"
      ]
    }
  }
}
