{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/model-critique/output.schema.json",
  "title": "Model Critique Skill Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "source_model",
    "artifact_files",
    "review_summary",
    "coverage",
    "model_impact",
    "gate_decision",
    "human_model_approval",
    "limitations"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critique_run_id",
        "version",
        "status",
        "created_at",
        "updated_at",
        "author_agent"
      ],
      "properties": {
        "critique_run_id": {
          "type": "string",
          "pattern": "^MCRIT-[A-Za-z0-9._-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "DRAFT",
            "COMPLETE",
            "BLOCKED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "author_agent": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        }
      }
    },
    "source_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modeling_id",
        "artifact_version",
        "gate_status"
      ],
      "properties": {
        "modeling_id": {
          "type": "string",
          "pattern": "^MODEL-[A-Za-z0-9._-]+$"
        },
        "artifact_version": {
          "type": "string"
        },
        "gate_status": {
          "const": "READY_FOR_MODEL_CRITIQUE"
        },
        "artifact_digest": {
          "type": "string"
        }
      }
    },
    "artifact_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessments",
        "revision_directives",
        "evidence_requests",
        "report"
      ],
      "properties": {
        "assessments": {
          "$ref": "#/$defs/fileDescriptor"
        },
        "revision_directives": {
          "$ref": "#/$defs/fileDescriptor"
        },
        "evidence_requests": {
          "$ref": "#/$defs/fileDescriptor"
        },
        "report": {
          "$ref": "#/$defs/fileDescriptor"
        }
      }
    },
    "review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_critiques",
        "accepted",
        "partially_accepted",
        "rejected_with_evidence",
        "requires_investigation",
        "unassessed"
      ],
      "properties": {
        "total_critiques": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "partially_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_with_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "requires_investigation": {
          "type": "integer",
          "minimum": 0
        },
        "unassessed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_critiques_assessed",
        "all_targets_resolved",
        "all_references_valid",
        "all_material_responses_evidence_backed"
      ],
      "properties": {
        "all_critiques_assessed": {
          "type": "boolean"
        },
        "all_targets_resolved": {
          "type": "boolean"
        },
        "all_references_valid": {
          "type": "boolean"
        },
        "all_material_responses_evidence_backed": {
          "type": "boolean"
        }
      }
    },
    "model_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_required",
        "investigation_required",
        "affected_model_ids",
        "affected_relation_ids",
        "affected_traceability_ids",
        "retained_model_ids",
        "retracted_model_ids",
        "residual_uncertainties"
      ],
      "properties": {
        "revision_required": {
          "type": "boolean"
        },
        "investigation_required": {
          "type": "boolean"
        },
        "affected_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MDL-[0-9]{3,}$"
          }
        },
        "affected_relation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REL-[0-9]{3,}$"
          }
        },
        "affected_traceability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TRC-[0-9]{3,}$"
          }
        },
        "retained_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MDL-[0-9]{3,}$"
          }
        },
        "retracted_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MDL-[0-9]{3,}$"
          }
        },
        "residual_uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale",
        "blocking_critique_ids",
        "blocking_request_ids",
        "required_next_actions",
        "next_state"
      ],
      "properties": {
        "status": {
          "enum": [
            "RETURN_TO_PROBLEM_ALIGNMENT",
            "RETURN_TO_INVESTIGATION",
            "RETURN_TO_SYSTEM_MODEL",
            "AWAITING_HUMAN_APPROVAL",
            "READY_FOR_CHANGE_OPTIONS",
            "BLOCKED"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 3
        },
        "blocking_critique_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CRIT-[0-9]{3,}$"
          }
        },
        "blocking_request_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EREQ-[0-9]{3,}$"
          }
        },
        "required_next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_state": {
          "enum": [
            "PROBLEM_ALIGNMENT",
            "INVESTIGATION",
            "SYSTEM_MODEL",
            "MODEL_CRITIQUE",
            "SOLUTION_DESIGN",
            "NONE"
          ]
        }
      }
    },
    "human_model_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_model_version": {
          "type": "string",
          "minLength": 1
        },
        "accepted_residual_uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "record_count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "JSONL",
            "YAML",
            "MARKDOWN"
          ]
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      }
    }
  }
}
