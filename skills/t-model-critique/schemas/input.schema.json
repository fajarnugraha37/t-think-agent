{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/model-critique/input.schema.json",
  "title": "Model Critique Skill Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "source_model",
    "source_evidence",
    "approved_problem_ids",
    "human_critiques",
    "review_policy"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "critique_run_id",
        "created_at"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "critique_run_id": {
          "type": "string",
          "pattern": "^MCRIT-[A-Za-z0-9._-]+$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "language": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        }
      }
    },
    "source_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "artifact_version",
        "modeling_id",
        "status",
        "gate_status",
        "elements_path",
        "relations_path",
        "traceability_path"
      ],
      "properties": {
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "modeling_id": {
          "type": "string",
          "pattern": "^MODEL-[A-Za-z0-9._-]+$"
        },
        "status": {
          "const": "COMPLETE"
        },
        "gate_status": {
          "const": "READY_FOR_MODEL_CRITIQUE"
        },
        "elements_path": {
          "type": "string",
          "minLength": 1
        },
        "relations_path": {
          "type": "string",
          "minLength": 1
        },
        "traceability_path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string"
        },
        "elements_digest": {
          "type": "string"
        },
        "relations_digest": {
          "type": "string"
        },
        "traceability_digest": {
          "type": "string"
        }
      }
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_path"
      ],
      "properties": {
        "ledger_path": {
          "type": "string",
          "minLength": 1
        },
        "ledger_digest": {
          "type": "string"
        }
      }
    },
    "approved_problem_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(PS|PE|AC|CST)-[0-9]{3,}$"
      }
    },
    "human_critiques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "critique-request.schema.json"
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_source_only",
        "context_firewall",
        "evaluate_not_obey",
        "require_evidence_for_rejection",
        "require_falsifiability",
        "allow_silent_model_mutation",
        "allow_solution_design"
      ],
      "properties": {
        "actual_source_only": {
          "const": true
        },
        "context_firewall": {
          "const": true
        },
        "evaluate_not_obey": {
          "const": true
        },
        "require_evidence_for_rejection": {
          "const": true
        },
        "require_falsifiability": {
          "const": true
        },
        "allow_silent_model_mutation": {
          "const": false
        },
        "allow_solution_design": {
          "const": false
        }
      }
    }
  }
}
