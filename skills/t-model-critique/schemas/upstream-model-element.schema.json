{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/system-modeling/model-element.schema.json",
  "title": "System Model Element",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "name",
    "description",
    "status",
    "confidence",
    "epistemic_basis",
    "problem_ids",
    "evidence_ids",
    "scope",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MDL-[0-9]{3,}$"
    },
    "type": {
      "enum": [
        "ACTOR",
        "ENTRY_POINT",
        "COMPONENT",
        "MODULE",
        "PROCESS",
        "OPERATION",
        "DATA_STORE",
        "DATA_ENTITY",
        "MESSAGE",
        "EVENT",
        "EXTERNAL_DEPENDENCY",
        "STATE",
        "STATE_TRANSITION",
        "TRANSACTION_BOUNDARY",
        "CONCURRENCY_BOUNDARY",
        "RETRY_BOUNDARY",
        "FAILURE_PATH",
        "SECURITY_BOUNDARY",
        "OWNERSHIP_BOUNDARY",
        "SOURCE_OF_TRUTH",
        "CONTRACT",
        "CONFIGURATION",
        "OBSERVABILITY_POINT",
        "INVARIANT",
        "ACTUAL_BEHAVIOR",
        "INTENDED_BEHAVIOR",
        "BEHAVIOR_GAP",
        "MODEL_LIMITATION"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "WEAKENED",
        "RETRACTED",
        "SUPERSEDED"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "epistemic_basis": {
      "enum": [
        "FACT_BACKED",
        "INFERENCE_BACKED",
        "ASSUMPTION_BACKED",
        "MIXED"
      ]
    },
    "problem_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(PS|PE|AC|CST)-[0-9]{3,}$"
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(F|INF|ASM|UNK|CON|INV|RSK)-[0-9]{3,}$"
      }
    },
    "supporting_fact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^F-[0-9]{3,}$"
      }
    },
    "supporting_inference_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^INF-[0-9]{3,}$"
      }
    },
    "assumption_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ASM-[0-9]{3,}$"
      }
    },
    "unknown_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^UNK-[0-9]{3,}$"
      }
    },
    "conflict_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CON-[0-9]{3,}$"
      }
    },
    "reasoning_summary": {
      "type": "string"
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsification_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceLocation"
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    },
    "invariant": {
      "$ref": "#/$defs/invariantDetail"
    },
    "behavior_gap": {
      "$ref": "#/$defs/behaviorGapDetail"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^MDL-[0-9]{3,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "epistemic_basis": {
            "enum": [
              "INFERENCE_BACKED",
              "MIXED"
            ]
          }
        },
        "required": [
          "epistemic_basis"
        ]
      },
      "then": {
        "required": [
          "reasoning_summary",
          "falsification_conditions"
        ],
        "properties": {
          "reasoning_summary": {
            "minLength": 1
          },
          "falsification_conditions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "epistemic_basis": {
            "const": "ASSUMPTION_BACKED"
          }
        },
        "required": [
          "epistemic_basis"
        ]
      },
      "then": {
        "required": [
          "assumption_ids",
          "limitations"
        ],
        "properties": {
          "assumption_ids": {
            "minItems": 1
          },
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "INVARIANT"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "invariant"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "BEHAVIOR_GAP"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "behavior_gap"
        ]
      }
    }
  ],
  "$defs": {
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "repository_id": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "invariantDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "scope",
        "enforcement_points",
        "failure_consequence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "enforcement_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_consequence": {
          "type": "string",
          "minLength": 1
        },
        "hardness": {
          "enum": [
            "HARD",
            "SOFT",
            "UNKNOWN"
          ]
        }
      }
    },
    "behaviorGapDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_element_ids",
        "intended_element_ids",
        "gap_statement",
        "impact"
      ],
      "properties": {
        "actual_element_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MDL-[0-9]{3,}$"
          }
        },
        "intended_element_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MDL-[0-9]{3,}$"
          }
        },
        "gap_statement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
