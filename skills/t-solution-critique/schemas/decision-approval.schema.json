{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Solution Decision Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_approval_id",
    "source_decision_id",
    "status",
    "selected_option_id",
    "candidate_option_ids",
    "approved_by",
    "approved_by_role",
    "approved_at",
    "decision_rationale",
    "accepted_assumption_ids",
    "accepted_risk_ids",
    "rejected_option_ids",
    "conditions",
    "residual_uncertainties",
    "authority_assertions"
  ],
  "properties": {
    "decision_approval_id": {
      "type": "string",
      "pattern": "^SAPP-[0-9]{3,}$"
    },
    "source_decision_id": {
      "type": "string",
      "pattern": "^DEC-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "selected_option_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^OPT-[0-9]{3,}$"
    },
    "candidate_option_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^OPT-[0-9]{3,}$"
      }
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "decision_rationale": {
      "type": "string"
    },
    "accepted_assumption_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(ASM|SASM)-[0-9]{3,}$"
      }
    },
    "accepted_risk_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(RSK|SRSK)-[0-9]{3,}$"
      }
    },
    "rejected_option_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^OPT-[0-9]{3,}$"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_is_human_decision",
        "implementation_not_authorized",
        "planning_only_next",
        "no_silent_semantic_change"
      ],
      "properties": {
        "selection_is_human_decision": {
          "const": true
        },
        "implementation_not_authorized": {
          "const": true
        },
        "planning_only_next": {
          "const": true
        },
        "no_silent_semantic_change": {
          "const": true
        }
      }
    },
    "approved_by_role": {
      "const": "HUMAN"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED"
          }
        }
      },
      "then": {
        "properties": {
          "selected_option_id": {
            "type": "string"
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "decision_rationale": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PENDING",
              "REJECTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "selected_option_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  ]
}
