{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solution Critique Evidence Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "trigger_critique_ids",
    "question",
    "required_evidence_type",
    "search_scope",
    "sources_to_inspect",
    "success_criteria",
    "blocking",
    "recommended_return_phase",
    "status"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^SEREQ-[0-9]{3,}$"
    },
    "trigger_critique_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SOLCRIT-[0-9]{3,}$"
      }
    },
    "question": {
      "type": "string",
      "minLength": 3
    },
    "required_evidence_type": {
      "enum": [
        "SOURCE_CODE",
        "CONFIGURATION",
        "TEST",
        "SCHEMA",
        "MIGRATION",
        "LOG",
        "TRACE",
        "DATABASE_STATE",
        "RUNTIME_REPRODUCTION",
        "DEPLOYMENT",
        "VERSION_HISTORY",
        "EXTERNAL_CONTRACT",
        "OTHER"
      ]
    },
    "search_scope": {
      "type": "string",
      "minLength": 3
    },
    "sources_to_inspect": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking": {
      "type": "boolean"
    },
    "recommended_return_phase": {
      "enum": [
        "INVESTIGATION",
        "SYSTEM_MODEL"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "FULFILLED",
        "CANCELLED"
      ]
    }
  }
}
