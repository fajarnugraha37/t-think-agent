{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solution Critique Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "critique_id",
    "target_ids",
    "classification",
    "resulting_status",
    "evidence_reviewed",
    "solution_items_reviewed",
    "reasoning_summary",
    "supporting_findings",
    "contradicting_findings",
    "alternative_interpretations",
    "falsification_conditions",
    "impact_if_wrong",
    "revision_directive_ids",
    "investigation_request_ids",
    "decision_impact"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "pattern": "^SCA-[0-9]{3,}$"
    },
    "critique_id": {
      "type": "string",
      "pattern": "^SOLCRIT-[0-9]{3,}$"
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(OPT|SCOV|DEC)-[0-9]{3,}$|^DOMINANCE-PROOF$|^SOLUTION-DESIGN-OUTPUT$"
      }
    },
    "classification": {
      "enum": [
        "ACCEPTED",
        "PARTIALLY_ACCEPTED",
        "REJECTED_WITH_EVIDENCE",
        "REQUIRES_INVESTIGATION"
      ]
    },
    "resulting_status": {
      "enum": [
        "RETAINED",
        "WEAKENED",
        "SOLUTION_REVISION_REQUIRED",
        "DECISION_REVISION_REQUIRED",
        "DOMINANCE_REVISION_REQUIRED",
        "INVESTIGATION_REQUIRED",
        "MODEL_REVISION_REQUIRED",
        "PROBLEM_REALIGNMENT_REQUIRED",
        "CLARIFICATION_REQUIRED"
      ]
    },
    "evidence_reviewed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(F|INF|ASM|UNK|CON|INV|RSK)-[0-9]{3,}$"
      }
    },
    "solution_items_reviewed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(OPT|SCOV|DEC)-[0-9]{3,}$|^DOMINANCE-PROOF$|^SOLUTION-DESIGN-OUTPUT$"
      }
    },
    "reasoning_summary": {
      "type": "string",
      "minLength": 3
    },
    "supporting_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contradicting_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternative_interpretations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "impact_if_wrong": {
      "type": "string",
      "minLength": 1
    },
    "revision_directive_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SREV-[0-9]{3,}$"
      }
    },
    "investigation_request_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SEREQ-[0-9]{3,}$"
      }
    },
    "decision_impact": {
      "enum": [
        "NONE",
        "BLOCKS_SELECTION",
        "CHANGES_RECOMMENDATION",
        "REQUIRES_REAPPROVAL"
      ]
    }
  }
}
