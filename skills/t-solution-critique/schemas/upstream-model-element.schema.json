{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "problem_ids",
    "evidence_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MDL-"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "problem_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariant": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
