{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation Planning Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "type",
    "severity",
    "blocking",
    "description",
    "affected_refs",
    "evidence_ids",
    "required_action",
    "route"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^PFND-[0-9]{3,}$"
    },
    "type": {
      "enum": [
        "EVIDENCE_GAP",
        "MODEL_CONFLICT",
        "SEMANTIC_DECISION_REQUIRED",
        "SOLUTION_CONFLICT",
        "SCOPE_CONFLICT",
        "PLAN_GAP",
        "UNKNOWN",
        "RISK",
        "REPOSITORY_DRIFT"
      ]
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "affected_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(F|INF|ASM|UNK|CON|INV|RSK)-"
      }
    },
    "required_action": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "enum": [
        "IMPLEMENTATION_PLAN",
        "INVESTIGATION",
        "SYSTEM_MODEL",
        "SOLUTION_DESIGN",
        "SOLUTION_CRITIQUE",
        "PROBLEM_ALIGNMENT"
      ]
    }
  }
}
