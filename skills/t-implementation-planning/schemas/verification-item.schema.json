{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation Verification Plan Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "title",
    "category",
    "plan_ids",
    "planning_target_ids",
    "preconditions",
    "environment",
    "command_or_method",
    "expected_result",
    "evidence_to_capture",
    "negative_path",
    "automation_status",
    "failure_route"
  ],
  "properties": {
    "verification_id": {
      "type": "string",
      "pattern": "^TST-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "REGRESSION_REPRODUCTION",
        "UNIT",
        "INTEGRATION",
        "CONTRACT",
        "CONCURRENCY",
        "MIGRATION",
        "SECURITY",
        "PERFORMANCE",
        "OBSERVABILITY",
        "ROLLBACK",
        "NEGATIVE_PATH",
        "COMPATIBILITY",
        "INVARIANT",
        "BUILD",
        "STATIC_ANALYSIS"
      ]
    },
    "plan_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PLN-"
      }
    },
    "planning_target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PTGT-"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "command_or_method": {
      "type": "string",
      "minLength": 1
    },
    "expected_result": {
      "type": "string",
      "minLength": 1
    },
    "evidence_to_capture": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative_path": {
      "type": "boolean"
    },
    "automation_status": {
      "enum": [
        "EXISTING",
        "TO_CREATE",
        "MANUAL",
        "NOT_AUTOMATABLE"
      ]
    },
    "failure_route": {
      "enum": [
        "IMPLEMENTATION",
        "IMPLEMENTATION_PLAN",
        "SOLUTION_DESIGN",
        "SYSTEM_MODEL",
        "INVESTIGATION"
      ]
    }
  }
}
