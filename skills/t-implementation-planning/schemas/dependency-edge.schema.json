{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation Plan Dependency Edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dependency_id",
    "from_plan_id",
    "to_plan_id",
    "relationship",
    "rationale"
  ],
  "properties": {
    "dependency_id": {
      "type": "string",
      "pattern": "^PDEP-[0-9]{3,}$"
    },
    "from_plan_id": {
      "type": "string",
      "pattern": "^PLN-"
    },
    "to_plan_id": {
      "type": "string",
      "pattern": "^PLN-"
    },
    "relationship": {
      "enum": [
        "REQUIRES",
        "ORDER_BEFORE",
        "BLOCKS",
        "VALIDATES"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
