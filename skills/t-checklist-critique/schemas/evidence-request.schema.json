{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/checklist-critique/evidence-request.schema.json",
  "title": "Checklist Critique Evidence Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "source_critique_id",
    "target_ids",
    "question",
    "required_evidence_type",
    "collection_method",
    "acceptance_criteria",
    "route",
    "blocking",
    "status"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^CCER-"
    },
    "source_critique_id": {
      "type": "string",
      "pattern": "^CCRQ-"
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "required_evidence_type": {
      "enum": [
        "CODE",
        "CONFIGURATION",
        "TEST",
        "RUNTIME",
        "DATABASE",
        "DEPENDENCY_GRAPH",
        "HUMAN_DECISION",
        "CONTRACT",
        "OTHER"
      ]
    },
    "collection_method": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "route": {
      "const": "INVESTIGATION"
    },
    "blocking": {
      "const": true
    },
    "status": {
      "const": "OPEN"
    }
  }
}
