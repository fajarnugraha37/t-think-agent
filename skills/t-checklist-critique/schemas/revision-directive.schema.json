{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/checklist-critique/revision-directive.schema.json",
  "title": "Checklist Revision Directive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directive_id",
    "source_critique_id",
    "target_ids",
    "change_type",
    "route",
    "reason",
    "required_change",
    "preserved_constraints",
    "evidence_ids",
    "model_ids",
    "semantic_change_required",
    "implementation_allowed",
    "applied",
    "status"
  ],
  "properties": {
    "directive_id": {
      "type": "string",
      "pattern": "^CCRD-"
    },
    "source_critique_id": {
      "type": "string",
      "pattern": "^CCRQ-"
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_type": {
      "enum": [
        "EDIT_ITEM",
        "SPLIT_ITEM",
        "REMOVE_ITEM",
        "ADD_MISSING_ITEM",
        "EDIT_DEPENDENCY",
        "EDIT_BATCH",
        "EDIT_COVERAGE",
        "EDIT_GUARD",
        "REBUILD_CHECKLIST",
        "REPLAN_OPERATION",
        "REAPPROVE_PLAN",
        "UPSTREAM_SEMANTIC_CHANGE"
      ]
    },
    "route": {
      "enum": [
        "IMPLEMENTATION_CHECKLIST",
        "PLAN_CRITIQUE",
        "IMPLEMENTATION_PLAN",
        "INVESTIGATION",
        "SYSTEM_MODEL",
        "SOLUTION_DESIGN",
        "SOLUTION_CRITIQUE",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "required_change": {
      "type": "string",
      "minLength": 1
    },
    "preserved_constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "semantic_change_required": {
      "type": "boolean"
    },
    "implementation_allowed": {
      "const": false
    },
    "applied": {
      "const": false
    },
    "status": {
      "const": "OPEN"
    }
  }
}
