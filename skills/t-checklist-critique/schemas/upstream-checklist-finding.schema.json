{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/checklist-builder/checklist-finding.schema.json",
  "title": "Checklist Builder Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "type",
    "severity",
    "blocking",
    "statement",
    "affected_ids",
    "evidence_ids",
    "route",
    "required_action"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^CBFND-[0-9]{3,}$"
    },
    "type": {
      "enum": [
        "SOURCE_CONTRACT_DRIFT",
        "PLAN_OPERATION_AMBIGUITY",
        "ATOMICITY_VIOLATION",
        "TRACEABILITY_GAP",
        "DEPENDENCY_CONFLICT",
        "VERIFICATION_GAP",
        "ROLLBACK_GAP",
        "EVIDENCE_GAP",
        "MODEL_GAP",
        "SEMANTIC_DECISION_REQUIRED",
        "APPROVAL_INVALID",
        "OTHER"
      ]
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "affected_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(F|INF|ASM|UNK|CON|INV|RSK)-"
      }
    },
    "route": {
      "enum": [
        "IMPLEMENTATION_CHECKLIST",
        "IMPLEMENTATION_PLAN",
        "PLAN_CRITIQUE",
        "INVESTIGATION",
        "SYSTEM_MODEL",
        "SOLUTION_DESIGN",
        "SOLUTION_CRITIQUE",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "required_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
