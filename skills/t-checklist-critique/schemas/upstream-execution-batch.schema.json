{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/checklist-builder/execution-batch.schema.json",
  "title": "Checklist Execution Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "sequence",
    "parallel_level",
    "checklist_ids",
    "execution_mode",
    "entry_conditions",
    "exit_conditions",
    "human_gate_required",
    "human_gate_reason",
    "rollback_item_ids",
    "status"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "pattern": "^BATCH-[0-9]{3,}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "parallel_level": {
      "type": "string",
      "pattern": "^LEVEL-[0-9]{3,}$"
    },
    "checklist_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CHK-"
      }
    },
    "execution_mode": {
      "enum": [
        "SEQUENTIAL",
        "PARALLEL"
      ]
    },
    "entry_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exit_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_gate_required": {
      "type": "boolean"
    },
    "human_gate_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollback_item_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RBK-"
      }
    },
    "status": {
      "const": "PLANNED"
    }
  }
}
