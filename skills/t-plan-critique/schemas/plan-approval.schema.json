{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/plan-critique/plan-approval.schema.json",
  "title": "Human Plan Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "status",
    "planning_run_id",
    "approved_plan_version",
    "approved_by",
    "approver_role",
    "approved_at",
    "resolved_critique_ids",
    "accepted_residual_risk_ids",
    "accepted_limitations",
    "approval_statement"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^PAPP-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "planning_run_id": {
      "type": "string",
      "pattern": "^IPLAN-"
    },
    "approved_plan_version": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approver_role": {
      "enum": [
        "HUMAN",
        "UNASSIGNED"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resolved_critique_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PCRQ-"
      }
    },
    "accepted_residual_risk_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(RSK|SRSK|PFND)-"
      }
    },
    "accepted_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_statement": {
      "type": "string",
      "minLength": 1
    }
  }
}
