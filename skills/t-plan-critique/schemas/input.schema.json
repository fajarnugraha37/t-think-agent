{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/plan-critique/input.schema.json",
  "title": "Plan Critique Skill Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "source_planning",
    "source_artifacts",
    "human_critiques",
    "review_policy"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "critique_run_id",
        "created_at",
        "author_agent"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "critique_run_id": {
          "type": "string",
          "pattern": "^PCRIT-"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "author_agent": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        }
      }
    },
    "source_planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_run_id",
        "artifact_version",
        "gate_status",
        "repository_commit"
      ],
      "properties": {
        "planning_run_id": {
          "type": "string",
          "pattern": "^IPLAN-"
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "gate_status": {
          "const": "READY_FOR_PLAN_CRITIQUE"
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "artifact_digest": {
          "type": "string"
        }
      }
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_output",
        "planning_targets",
        "plan_items",
        "dependency_edges",
        "coverage_matrix",
        "verification_plan",
        "rollback_plan",
        "planning_findings",
        "approved_solution_contract",
        "evidence_ledger",
        "model_elements",
        "model_relations"
      ],
      "properties": {
        "planning_output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "planning_targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "plan_items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dependency_edges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "coverage_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "verification_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rollback_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "planning_findings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "approved_solution_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidence_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "model_elements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "model_relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "enum": [
                "JSONL",
                "YAML",
                "CSV",
                "MARKDOWN"
              ]
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "human_critiques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "critique-request.schema.json"
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_source_only",
        "context_firewall",
        "evaluate_not_obey",
        "require_evidence_for_rejection",
        "require_falsifiability",
        "allow_silent_plan_mutation",
        "allow_implementation",
        "allow_new_semantic_decisions"
      ],
      "properties": {
        "actual_source_only": {
          "const": true
        },
        "context_firewall": {
          "const": true
        },
        "evaluate_not_obey": {
          "const": true
        },
        "require_evidence_for_rejection": {
          "const": true
        },
        "require_falsifiability": {
          "const": true
        },
        "allow_silent_plan_mutation": {
          "const": false
        },
        "allow_implementation": {
          "const": false
        },
        "allow_new_semantic_decisions": {
          "const": false
        }
      }
    }
  }
}
