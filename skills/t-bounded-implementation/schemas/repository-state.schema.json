{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/bounded-implementation/repository-state.schema.json",
  "title": "Repository State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository_id",
    "branch",
    "commit_sha",
    "working_tree_status",
    "tree_digest",
    "changed_paths",
    "captured_at"
  ],
  "properties": {
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "working_tree_status": {
      "enum": [
        "CLEAN",
        "DIRTY"
      ]
    },
    "tree_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "changed_paths": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
