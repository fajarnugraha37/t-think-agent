{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/bounded-implementation/implementation-result-contract.schema.json",
  "title": "Implementation Result Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "status",
    "implementation_run_id",
    "source_checklist_contract_id",
    "source_checklist_bundle_digest",
    "source_plan_contract_id",
    "repository_before",
    "repository_after",
    "implementation_bundle_digest",
    "completed_checklist_ids",
    "failed_checklist_ids",
    "change_ids",
    "command_result_ids",
    "verification_result_ids",
    "rollback_result_ids",
    "finding_ids",
    "scope_integrity",
    "semantic_integrity",
    "execution_integrity",
    "limitations"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^IMPLCON-"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "FAILED",
        "BLOCKED"
      ]
    },
    "implementation_run_id": {
      "type": "string",
      "pattern": "^BIMPL-"
    },
    "source_checklist_contract_id": {
      "type": "string",
      "pattern": "^CHKCON-"
    },
    "source_checklist_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_plan_contract_id": {
      "type": "string",
      "pattern": "^PLANCON-"
    },
    "repository_before": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.local/schemas/bounded-implementation/repository-state.schema.json",
      "title": "Repository State",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "branch",
        "commit_sha",
        "working_tree_status",
        "tree_digest",
        "changed_paths",
        "captured_at"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "working_tree_status": {
          "enum": [
            "CLEAN",
            "DIRTY"
          ]
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "repository_after": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.local/schemas/bounded-implementation/repository-state.schema.json",
      "title": "Repository State",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "branch",
        "commit_sha",
        "working_tree_status",
        "tree_digest",
        "changed_paths",
        "captured_at"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "working_tree_status": {
          "enum": [
            "CLEAN",
            "DIRTY"
          ]
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "implementation_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "completed_checklist_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^CHK-"
      },
      "uniqueItems": true
    },
    "failed_checklist_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^CHK-"
      },
      "uniqueItems": true
    },
    "change_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^CHG-"
      },
      "uniqueItems": true
    },
    "command_result_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^CMD-"
      },
      "uniqueItems": true
    },
    "verification_result_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^VRES-"
      },
      "uniqueItems": true
    },
    "rollback_result_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^RRES-"
      },
      "uniqueItems": true
    },
    "finding_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^IFND-"
      },
      "uniqueItems": true
    },
    "scope_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unexpected_paths"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "unexpected_paths": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "semantic_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "new_decision_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "new_decision_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "execution_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_preserved",
        "human_gates_honored",
        "failure_budget_respected",
        "all_records_evidence_backed"
      ],
      "properties": {
        "order_preserved": {
          "type": "boolean"
        },
        "human_gates_honored": {
          "type": "boolean"
        },
        "failure_budget_respected": {
          "type": "boolean"
        },
        "all_records_evidence_backed": {
          "type": "boolean"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
