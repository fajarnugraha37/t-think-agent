{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "lane",
    "task_results",
    "source_changes",
    "commands",
    "diff",
    "new_semantic_decision",
    "status",
    "next_state",
    "required_route"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "enum": [
        "quick",
        "standard",
        "full"
      ]
    },
    "task_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "COMPLETED",
              "FAILED",
              "BLOCKED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "source_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "evidence_ref"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "new_semantic_decision": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "READY_FOR_IMPLEMENTATION_REVIEW",
        "RETURN_REQUIRED",
        "BLOCKED"
      ]
    },
    "next_state": {
      "enum": [
        "IMPLEMENTATION_REVIEW",
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_BLUEPRINT",
        "SOLUTION_DESIGN",
        "PROBLEM_ALIGNMENT"
      ]
    },
    "required_route": {
      "enum": [
        "BOUNDED_IMPLEMENTATION",
        "IMPLEMENTATION_BLUEPRINT",
        "SOLUTION_DESIGN",
        "PROBLEM_ALIGNMENT",
        null
      ]
    }
  }
}
