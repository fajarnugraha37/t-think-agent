{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/bounded-implementation/verification-result.schema.json",
  "title": "Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "implementation_run_id",
    "verification_item_id",
    "checklist_ids",
    "command_result_ids",
    "verification_type",
    "expected",
    "observed",
    "outcome",
    "evidence_refs",
    "limitations"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^VRES-"
    },
    "implementation_run_id": {
      "type": "string",
      "pattern": "^BIMPL-"
    },
    "verification_item_id": {
      "type": "string",
      "pattern": "^TST-"
    },
    "checklist_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^CHK-"
      },
      "uniqueItems": true
    },
    "command_result_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^CMD-"
      },
      "uniqueItems": true
    },
    "verification_type": {
      "enum": [
        "UNIT",
        "INTEGRATION",
        "CONTRACT",
        "STATIC_ANALYSIS",
        "MIGRATION",
        "CONCURRENCY",
        "SECURITY",
        "OBSERVABILITY",
        "MANUAL_INSPECTION",
        "RUNTIME_PROBE"
      ]
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
